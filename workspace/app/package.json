{
  "name": "underwriting-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "tsx scripts/run-evals.ts",
    "verify": "npm run typecheck && npm run test && npm run evals && npm run eval:extraction >/dev/null && npm run demo >/dev/null && npm run build && npm run e2e",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "tsx scripts/demo-e2e.ts",
    "e2e": "bash scripts/e2e-web.sh",
    "eval:extraction": "tsx scripts/eval-extraction.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
