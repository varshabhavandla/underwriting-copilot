{
  "name": "underwriting-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "tsx scripts/run-evals.ts",
    "verify": "npm run typecheck && npm run secret-scan && npm run test && npm run evals && npm run eval:extraction >/dev/null && EVAL_N=3 EVAL_OUT=$(mktemp) npm run eval:pipeline >/dev/null && npm run demo >/dev/null && npm run build && npm run e2e",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "tsx scripts/demo-e2e.ts",
    "e2e": "bash scripts/e2e-web.sh",
    "eval:extraction": "tsx scripts/eval-extraction.ts",
    "docs:rules": "tsx scripts/rule-pack-doc.ts",
    "eval:pipeline": "tsx scripts/eval-pipeline.ts",
    "timing": "tsx scripts/timing-analysis.ts",
    "export:packets": "tsx scripts/export-packets.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "version": "0.1.0"
}
